      <Link>vulkan_dzn.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DxilValidatorPath)">
      <Link>DXIL.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
