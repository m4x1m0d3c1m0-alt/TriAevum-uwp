    <Image Include="Assets\SplashScreen.png" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="GeneratePlaceholderPackageAssets" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)GenerateAssets.ps1&quot; -OutputDirectory &quot;$(ProjectDir)Assets&quot;" />
  </Target>
</Project>
